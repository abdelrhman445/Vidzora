# --- Telegram ---
BOT_TOKEN=123456:ABC-your-bot-father-token
ADMIN_USER_IDS=111111111,222222222

# --- MongoDB ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=youtube_automation

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Images ---
IMAGE_PROVIDER=huggingface
HUGGINGFACE_API_KEY=your-hf-token
HUGGINGFACE_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
LEONARDO_API_KEY=
LEONARDO_MODEL_ID=

# --- Mixed media: stock video clips alongside AI images ---
ENABLE_STOCK_FOOTAGE=false
PEXELS_API_KEY=

# --- TTS ---
TTS_VOICE=en-US-GuyNeural

# --- Video ---
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
CROSSFADE_DURATION_SEC=0.6

# --- Captions ---
ENABLE_SUBTITLES=true
SUBTITLE_FONT_SIZE=64
SUBTITLE_FONT_PATH=

# --- Background music ---
BACKGROUND_MUSIC_PATH=
BACKGROUND_MUSIC_VOLUME=0.12

# --- Intro / outro cards ---
ENABLE_INTRO_CARD=true
ENABLE_OUTRO_CARD=true
OUTRO_TEXT=Thanks for watching!\nLike & Subscribe
INTRO_OUTRO_DURATION_SEC=2.5
